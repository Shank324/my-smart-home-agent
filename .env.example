# 复制为 .env 后填写真实值：  Copy-Item .env.example .env
# ---------------------------------------------------------------
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@mysql:3306/smarthome

MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=smarthome

# 大模型（OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 知识库检索
#   KNOWLEDGE_EMBEDDER: vllm | dashscope | hash
#     vllm      —— 自建 vLLM 的 OpenAI 兼容 embedding 接口
#     dashscope —— 阿里云百炼「通义多模态向量」原生接口（DeepSeek 无 embedding 接口）
#     hash      —— 无语义的哈希兜底，仅用于离线跑通链路
#   KNOWLEDGE_VECTOR_BACKEND: json | qdrant
KNOWLEDGE_EMBEDDER=hash
EMBEDDING_API_KEY=
EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
EMBEDDING_DIMENSIONS=768
KNOWLEDGE_VECTOR_BACKEND=json
KNOWLEDGE_DATA_DIR=seed_data

VITE_API_BASE=http://localhost:8000

# 构建加速（可选）：无法直连 Docker Hub / PyPI 时指向国内镜像源
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
